# =============================================================================
# StockGuard — copy to .env and fill in. NEVER commit .env.
# Everything is optional: with an empty .env the board, API and web app still run.
# =============================================================================

# ---- worker: polling & alerts ------------------------------------------------
POLL_INTERVAL_SEC=60
ALERT_TRIGGER_BPS=200          # 2.00% away from NAV
ALERT_CLEAR_BPS=100            # back under 1.00% = recovered
ALERT_CONFIRM_POLLS=2          # must hold for 2 checks in a row
ALERT_MIN_LIQUIDITY_USD=10000  # thinner pools are shown but never alert
ALERT_REARM_MIN=60             # a repeat depeg within 60 min of a recovery is logged but not re-posted

# Telegram channel alerts (create a bot with @BotFather, add it as admin of your channel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=              # e.g. @stockguard_alerts or -100xxxxxxxxxx
PUBLIC_APP_URL=                # e.g. https://stockguard.example — used for links in alerts

# ---- on-chain mirror (Base Sepolia testnet only) -------------------------------
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
LASNA_RPC_URL=https://lasna-rpc.rnk.dev/
STOCKGUARD_REGISTRY_ADDRESS=   # from docs/DEPLOY.md step 2
STOCKGUARD_RSC_ADDRESS=        # DepegSentinelRSC on Reactive Lasna, step 3
# A NEW burner key holding only testnet ETH. Never a wallet with real funds.
REPORTER_PRIVATE_KEY=
ONCHAIN_HEARTBEAT_SYMBOLS=     # e.g. AAPLc,NVDAc,TSLAc — periodic reportMarket for these
ONCHAIN_HEARTBEAT_HOURS=6
AUTO_CLEAR_BREAKER=false       # true = clear the breaker automatically on recovery (owner key)

# ---- API ----------------------------------------------------------------------
PORT=8787
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MIN=120
# x402 pay-per-call agent endpoint. Leave X402_PAY_TO empty to disable.
X402_PAY_TO=                   # address that receives USDC
X402_NETWORK=eip155:84532      # Base Sepolia. Base mainnet = eip155:8453 (needs a mainnet facilitator)
X402_PRICE=$0.001
X402_FACILITATOR_URL=https://x402.org/facilitator

# ---- web (Vite exposes only VITE_*) ---------------------------------------------
VITE_API_BASE=                 # empty when the API is on the same origin / dev proxy
VITE_TELEGRAM_URL=             # public channel link, e.g. https://t.me/stockguard_alerts
VITE_X_URL=                    # your build-in-public X profile
VITE_BASE_BUILDER_CODE=        # bc_xxxxxxxx from base.dev — only on user-signed attestations
VITE_STOCKGUARD_REGISTRY_ADDRESS=
VITE_STOCKGUARD_CHAIN=base-sepolia
